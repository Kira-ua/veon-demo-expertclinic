---
import { getImage } from "astro:assets";
import wide from "../assets/img/reception-wide.jpg";
import narrow from "../assets/img/reception-mobile.jpg";
import CallButton from "./CallButton.astro";
import Icon from "./Icon.astro";
import { CLINICS } from "../data/clinic";

interface Props { h1: string; }
const { h1 } = Astro.props;

const wideW = [768, 1280, 1680];
const narrowW = [400, 800, 1120];
const [wideAvif, wideWebp, narrowAvif, narrowWebp, fallback] = await Promise.all([
  Promise.all(wideW.map((w) => getImage({ src: wide, width: w, format: "avif" }))),
  Promise.all(wideW.map((w) => getImage({ src: wide, width: w, format: "webp" }))),
  Promise.all(narrowW.map((w) => getImage({ src: narrow, width: w, format: "avif" }))),
  Promise.all(narrowW.map((w) => getImage({ src: narrow, width: w, format: "webp" }))),
  getImage({ src: wide, width: 1280, format: "jpg" }),
]);
const set = (imgs: { src: string }[], ws: number[]) => imgs.map((i, n) => `${i.src} ${ws[n]}w`).join(", ");
const wideSizes = "(min-width: 1344px) 1280px, calc(100vw - 2 * 2.5rem)";
const narrowSizes = "calc(100vw - 2.5rem)";
---
<section id="hero" class="hero" data-rec="R-101,R-103,R-202,R-301,R-209,G-RS01,M-R004" aria-labelledby="hero-title">
  <div class="container hero__grid">
    <h1 id="hero-title" class="hero__title">{h1}</h1>

    <div class="hero__desk">
      <p class="hero__lead">Від профілактики до складних реабілітацій — дорослим і дітям, у двох клініках.</p>

      <div class="hero__action">
        <CallButton class="hero__call btn--lg" />
        <a class="link-line hero__choose" href="#contacts">Обрати клініку</a>
      </div>

      <div class="hero__where">
        <ul class="hero__addr">
          {CLINICS.map((c) => (
            <li><a href={c.map} target="_blank" rel="noopener"><Icon name="pin" /><span>{c.full}<span class="visually-hidden">, маршрут на карті</span></span></a></li>
          ))}
        </ul>
        <p class="hero__hours">Пн–Пт 9:00–21:00, Сб 9:00–16:00</p>
      </div>
    </div>
  </div>

  <div class="container">
    <picture class="hero__photo">
      <source media="(min-width: 768px)" type="image/avif" srcset={set(wideAvif, wideW)} sizes={wideSizes} />
      <source media="(min-width: 768px)" type="image/webp" srcset={set(wideWebp, wideW)} sizes={wideSizes} />
      <source type="image/avif" srcset={set(narrowAvif, narrowW)} sizes={narrowSizes} />
      <source type="image/webp" srcset={set(narrowWebp, narrowW)} sizes={narrowSizes} />
      <img
        src={fallback.src}
        width="1680" height="735"
        alt="Ресепшн клініки ЕКСПЕРТ: салатова хвиляста стіна з логотипом-зубом, біла стійка реєстратури, кабінети за склом"
        fetchpriority="high" decoding="async"
      />
    </picture>
  </div>
</section>

<style>
  .hero { padding-top: calc(var(--header-h) + var(--s-3)); padding-bottom: var(--s-5); }
  .hero__grid { display: grid; gap: var(--s-3); }
  .hero__title { font-size: var(--fs-h1); line-height: var(--lh-h1); letter-spacing: -0.02em; max-width: 15ch; }
  .hero__desk { display: grid; gap: var(--s-3); }
  .hero__lead { color: var(--color-text-muted); max-width: 34ch; }
  .hero__action { display: grid; gap: var(--s-1); }
  .hero__action :global(.hero__call) { width: 100%; justify-content: flex-start; }
  .hero__choose { display: none; }
  .hero__where { display: grid; gap: .25rem; }
  .hero__addr a {
    display: flex; align-items: center; gap: .5rem; min-height: var(--tap);
    color: var(--color-link); font-weight: 500; text-decoration: underline; text-decoration-color: var(--color-border);
    text-decoration-thickness: 2px; text-underline-offset: .3em;
  }
  .hero__addr a:hover { text-decoration-color: var(--color-focus); }
  .hero__addr :global(svg) { width: 20px; height: 20px; flex: none; }
  .hero__hours { font-size: var(--fs-cap); color: var(--color-text-muted); }

  .hero__photo { display: block; margin-top: var(--s-3); }
  .hero__photo img {
    width: 100%; height: auto; aspect-ratio: 1120 / 900; object-fit: cover;
    border-radius: var(--radius-img);
    background: var(--color-surface);
    animation: window-open-v 600ms var(--ease-out) both;
  }
  @keyframes window-open-v { from { clip-path: inset(6% 0 6% 0 round var(--radius-img)); } to { clip-path: inset(0 0 0 0 round var(--radius-img)); } }
  @keyframes window-open { from { clip-path: inset(0 8% 0 8% round var(--radius-img)); } to { clip-path: inset(0 0 0 0 round var(--radius-img)); } }

  @media (min-width: 768px) {
    .hero__photo img { aspect-ratio: 16 / 7; animation: window-open 900ms var(--ease-out) both; }
    .hero__desk { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: start; column-gap: var(--s-4); }
    .hero__lead { grid-column: 1 / -1; }
  }
  @media (min-width: 1024px) {
    .hero { padding-top: calc(var(--header-h) + var(--s-4)); padding-bottom: 0; }
    .hero__grid { gap: var(--s-4); }
    .hero__title { max-width: 21ch; }
    .hero__desk {
      grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gap);
      padding-top: var(--s-3); border-top: 1px solid var(--color-border);
    }
    .hero__lead { grid-column: 1 / span 4; font-size: var(--fs-h3); line-height: 1.4; color: var(--color-text); }
    .hero__action { grid-column: 5 / span 4; }
    .hero__action { justify-items: start; }
    .hero__action :global(.hero__call) { width: auto; min-width: 20rem; }
    .hero__choose { display: inline-flex; }
    .hero__where { grid-column: 9 / span 4; }
    .hero__addr a { white-space: nowrap; }
    .hero__photo { margin-top: var(--s-4); }
    .hero__photo img { aspect-ratio: 16 / 6; object-position: 50% 45%; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__photo img { animation: none; clip-path: none; }
  }
</style>
